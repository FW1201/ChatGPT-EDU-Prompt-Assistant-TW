{
  "manifest_version": 3,
  "name": "ChatGPT EDU Prompt Assistant (TW)",
  "version": "1.2.0",
  "description": "為台灣教育場域設計的 ChatGPT 提示詞模板，點擊按鈕即可直接將指令貼入 ChatGPT 輸入框。",
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatGPT EDU Prompt Assistant",
    "default_icon": "128.png"
  },
  "icons": {
    "128": "128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": ["content.js"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://generativelanguage.googleapis.com;"
  }
}
