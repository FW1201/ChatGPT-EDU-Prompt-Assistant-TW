{
  "manifest_version": 3,
  "name": "ChatGPT EDU Prompt Assistant (TW)",
  "version": "2.0.0",
  "minimum_chrome_version": "116",
  "description": "台灣教育提示詞側邊欄：196 則雙語模板、填空預覽、收藏、自定義提示詞與備份同步。",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "action": { "default_title": "ChatGPT EDU Prompt Assistant", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "128.png" } },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "128.png" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{ "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content.js"] }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self';" }
}
